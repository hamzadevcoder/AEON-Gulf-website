# ---------------------------------------------------------------- Required
# PostgreSQL connection (14+). Example: postgres://user:password@host:5432/aeon
DATABASE_URL=
# Long random string used for hashing IP addresses (e.g. `openssl rand -base64 32`)
AUTH_SECRET=
# Public address of the site (used in sitemap, canonical URLs and email links)
NEXT_PUBLIC_SITE_URL=https://www.aeongulf.com

# ---------------------------------------------------------------- Database options
DATABASE_POOL_SIZE=10
# Set to true for managed databases that require TLS (most do)
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# ---------------------------------------------------------------- Email notifications (SMTP)
# Recipients and sender name are managed in the dashboard under Settings & emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Default sender address if none is set in the dashboard
SMTP_FROM=

# ---------------------------------------------------------------- Image uploads
# Default: local disk (keep this folder on a persistent volume and back it up)
UPLOAD_DIR=storage/uploads
# Or an S3-compatible bucket (AWS S3, Cloudflare R2, DigitalOcean Spaces): set all of these
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ---------------------------------------------------------------- Optional
# Time zone for dates in the dashboard
NEXT_PUBLIC_TIMEZONE=Asia/Kuwait
# Email for the first notification recipient created by `npm run db:seed`
SEED_NOTIFY_EMAIL=
